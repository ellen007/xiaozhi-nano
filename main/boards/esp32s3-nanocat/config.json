{
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32s3-nanocat-v1-no-auto-ota",
            "sdkconfig_append": [
                "CONFIG_AUTO_FIRMWARE_UPGRADE=n",
                "CONFIG_LANGUAGE_ZH_CN=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y"
            ]
        }
    ]
}
